# Скопируйте в .env и поменяйте нужное. Файл .env в git не попадает.
# Без .env docker compose использует значения по умолчанию из docker-compose.yml.

SPRING_PROFILES_ACTIVE=docker          # local | docker | test
AIEX_PORT=8080                        # порт приложения на хосте
AIEX_DB_PORT=5432                     # порт PostgreSQL на хосте (127.0.0.1)

POSTGRES_DB=aiex
POSTGRES_USER=aiex
POSTGRES_PASSWORD=aiex

AIEX_LIQUIBASE_CONTEXTS=demo          # demo — демо-пользователи и специалист; пусто — только схема и справочники

AIEX_LLM_PROVIDER=stub                # stub | openai | ollama
AIEX_LLM_BASE_URL=                    # openai: https://api.openai.com/v1, ollama: http://host.docker.internal:11434/v1
AIEX_LLM_API_KEY=                     # в логи не попадает никогда
AIEX_LLM_MODEL=                       # например gpt-4o-mini или llama3.1
AIEX_LLM_TIMEOUT_MS=20000
AIEX_LLM_MAX_RETRIES=2                # ретраи только на 5xx, 429 и таймауты

AIEX_AGENT_HISTORY_WINDOW=20          # сколько последних сообщений уходит в промпт
AIEX_AGENT_MAX_OUTPUT_TOKENS=512
AIEX_PAGINATION_MAX_SIZE=50           # жёсткий потолок размера страницы
AIEX_IMPORT_MAX_FILE_MB=20
AIEX_IMPORT_MAX_MESSAGES=50000

AIEX_LOG_FORMAT=ecs                   # JSON-логи в stdout (ecs | logstash | gelf)
JAVA_OPTS=-XX:MaxRAMPercentage=75
PGADMIN_PASSWORD=admin                 # docker compose --profile tools up
